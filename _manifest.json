{
  "manifest_version": 2,
  "id": "github.TommyAAKK.maibot-I-deepseek",
  "version": "1.1.0",
  "name": "我，deepseek",
  "description": "为 MaiBot 补充 A_Memorix 未覆盖的情境连续性记忆：未闭合话题、对方情绪、关系线索、自身连续性、共创线索，并在 replyer 阶段以额外回复要求的形式注入。",
  "author": {
    "name": "TommyAAKK",
    "url": "https://github.com/TommyAAKK"
  },
  "license": "MIT",
  "urls": {
    "repository": "https://github.com/TommyAAKK/maibot-I-deepseek",
    "homepage": "https://github.com/TommyAAKK/maibot-I-deepseek",
    "documentation": "https://github.com/TommyAAKK/maibot-I-deepseek#readme",
    "issues": "https://github.com/TommyAAKK/maibot-I-deepseek/issues"
  },
  "host_application": {
    "min_version": "1.3.0",
    "max_version": "2.0.0"
  },
  "sdk": {
    "min_version": "2.9.0",
    "max_version": "3.0.0"
  },
  "plugin_type": "data",
  "dependencies": [],
  "capabilities": [
    "config.get",
    "message.get_recent",
    "llm.generate",
    "frequency.get_adjust",
    "frequency.set_adjust",
    "maisaka.proactive.trigger",
    "database.query",
    "api.call"
  ],
  "i18n": {
    "default_locale": "zh-CN"
  }
}
